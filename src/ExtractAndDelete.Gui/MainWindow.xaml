<Window
    x:Class="ExtractAndDelete.Gui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="提取压缩文件夹">
    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" KeyDown="RootGrid_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Padding="28,18,28,22" Spacing="14" Width="760" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button x:Name="BackButton" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" IsEnabled="False"
                        Width="32" Height="32" Padding="0" AutomationProperties.Name="返回" />
                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="22" VerticalAlignment="Center"
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumHighBrush}" />
                <TextBlock Text="提取压缩文件夹" FontSize="18" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="选择一个目标并提取文件" FontSize="22" Foreground="#005FB8" Margin="20,26,0,12" />

            <TextBlock Text="文件将被提取到这个文件夹(F):" FontSize="14" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{x:Bind ViewModel.TargetPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{x:Bind ViewModel.CanSelectPaths, Mode=OneWay}"
                         AutomationProperties.Name="提取目标文件夹" />
                <Button Grid.Column="1" Content="浏览(R)..." AccessKey="R" Click="ChooseFolderButton_Click"
                        IsEnabled="{x:Bind ViewModel.CanSelectPaths, Mode=OneWay}"
                        AutomationProperties.Name="浏览目标文件夹" />
            </Grid>

            <CheckBox x:Name="ShowFilesCheckBox" Content="完成时显示提取的文件(H)" AccessKey="H"
                      IsChecked="{x:Bind ViewModel.ShowExtractedFiles, Mode=TwoWay}"
                      IsEnabled="{x:Bind ViewModel.CanSelectPaths, Mode=OneWay}"
                      Margin="0,12,0,0"
                      AutomationProperties.Name="完成时显示提取的文件" />

            <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Spacing="8" Margin="0,14,0,0">
                <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind ViewModel.ProgressPercentage, Mode=OneWay}"
                             IsIndeterminate="{x:Bind ViewModel.IsProgressIndeterminate, Mode=OneWay}"
                             AutomationProperties.Name="提取进度" />
                <TextBlock Text="{x:Bind ViewModel.CurrentEntry, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                           AutomationProperties.Name="当前文件" />
            </StackPanel>

            <TextBlock x:Name="StatusTextBlock" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.Name="状态与错误信息" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"
                    Padding="28,12,28,18">
            <Button x:Name="ExecuteButton" Content="提取并回收(E)" AccessKey="E" Click="ExecuteButton_Click"
                    IsEnabled="{x:Bind ViewModel.CanExecute, Mode=OneWay}"
                    AutomationProperties.Name="提取并回收" />
            <Button x:Name="CancelButton" Content="取消" Click="CancelButton_Click"
                    IsEnabled="{x:Bind ViewModel.CanCancelButton, Mode=OneWay}"
                    AutomationProperties.Name="取消" />
        </StackPanel>
    </Grid>
</Window>
